# ============================================
# تنظیمات اصلی برنامه
# ============================================
VITE_APP_NAME="نام برنامه شما"
VITE_APP_DESCRIPTION="توضیح کوتاه درباره برنامه"

# ============================================
# تنظیمات Supabase (در صورت استفاده)
# ============================================
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# ============================================
# تنظیمات پرداخت درون برنامه‌ای
# ============================================
# انتخاب استور: "myket" یا "bazaar"
VITE_BILLING_PROVIDER="myket"

# کلید RSA مایکت (اگر VITE_BILLING_PROVIDER = myket)
VITE_MYKET_RSA_KEY="کلید_RSA_مایکت_شما"

# کلید RSA کافه بازار (اگر VITE_BILLING_PROVIDER = bazaar)
VITE_BAZAAR_RSA_KEY="کلید_RSA_کافه_بازار_شما"

# شناسه محصولات (SKU) - این‌ها را در پنل استور انتخابی خود بسازید
VITE_PRODUCT_COIN_5="sku_product_1"
VITE_PRODUCT_COIN_15="sku_product_2"
VITE_PRODUCT_PREMIUM="sku_premium_product"

# ============================================
# تنظیمات Gemini AI (در صورت استفاده)
# ============================================
VITE_GEMINI_API_KEY="your-gemini-api-key"

# ============================================
# تنظیمات تبلیغات تپسل (Tapsell)
# ============================================
VITE_TAPSELL_TOKEN="your_tapsell_token_here"
VITE_TAPSELL_BANNER_ZONE="your_banner_zone_id"
VITE_TAPSELL_INTERSTITIAL_ZONE="your_interstitial_zone_id"
VITE_TAPSELL_REWARDED_ZONE="your_rewarded_zone_id"