# App Metadata
VITE_APP_NAME="Undo Download Manager"
VITE_APP_DESCRIPTION="مدیر دانلود هوشمند آندو مجهز به موتور قدرتمند yt-dlp"

# In-App Billing Provider ('bazaar' | 'myket' | 'auto')
VITE_BILLING_PROVIDER="auto"

# RSA Public Keys for In-App Billing
# Cafe Bazaar RSA Public Key (Get from Bazaar Developer Console > App > In-App Billing)
VITE_BAZAAR_RSA_KEY=""

# Myket RSA Public Key (Get from Myket Developer Console > App > In-App Billing)
VITE_MYKET_RSA_KEY=""

# Product SKUs (Configurable or leave blank to use defaults)
# Consumables (Coins / Downloads count)
VITE_PRODUCT_COIN_10="coins_10_download"
VITE_PRODUCT_COIN_30="coins_30_download"

# Subscriptions / Non-consumables
VITE_PRODUCT_UNLIMITED_1M="sub_unlimited_1m"
VITE_PRODUCT_UNLIMITED_3M="sub_unlimited_3m"
VITE_PRODUCT_UNLIMITED_1Y="sub_unlimited_1y"

# Server / AI APIs
GEMINI_API_KEY=""